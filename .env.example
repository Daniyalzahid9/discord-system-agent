# -------------------------------------------------------------
# DISCORD AUTONOMOUS SYSTEM AGENT CONFIGURATION
# -------------------------------------------------------------

# 1. DISCORD BOT TOKEN (From Discord Developer Portal -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# 2. YOUR DISCORD USER ID (Right click your Discord username -> Copy User ID)
# Strictly prevents anyone else from controlling your machine!
# Multiple IDs can be separated by commas: 123456789012345678,987654321098765432
ALLOWED_USER_IDS=YOUR_DISCORD_USER_ID_HERE

# 3. COMMAND PREFIX FOR TEXT FALLBACK (Slash commands /screen, /agent are also enabled)
COMMAND_PREFIX=!

# 4. DEFAULT WORKSPACE PATH FOR AGENTS
DEFAULT_WORKSPACE=C:\Users\daniy

# 5. ANTIGRAVITY CLI EXECUTABLE
AGY_PATH=agy

# 6. EMAIL CONFIGURATION (Optional - for touchless reports)
# For Gmail, use an App Password (Google Account -> Security -> 2-Step -> App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
DEFAULT_EMAIL_TO=your_target_email@gmail.com
 
# 7. STATIC REMOTE WEB TOKEN (Optional - set a fixed pin so your browser bookmark never changes)
REMOTE_STATIC_TOKEN=sentient_desktop_secret_key
